// PlatoDNS — Standalone dylib (no jailbreak required)
// ---------------------------------------------------
// Injected into a host app via Sideloadly / TrollStore / Feather, this adds a
// small floating bubble to the screen. Tapping it opens a menu with three
// actions, all local and user-approved:
//
//   1) Generate DoH profile  — builds a Cloudflare DNS-over-HTTPS
//      .mobileconfig and opens the system Share Sheet so the user can
//      save/open it. iOS then asks the user to approve installing it in
//      Settings — nothing is installed silently.
//   2) Generate DoT profile  — same, but DNS-over-TLS.
//   3) Check DNS latency     — a plain getaddrinfo() timing check, shown to
//      the user as an alert. Not a guarantee of the exact resolver path.
//
// This file intentionally does NOT hook into the host app's own networking,
// sockets, or any private API. It only presents its own UI and writes/shares
// its own file.

#import <UIKit/UIKit.h>
#import <Foundation/Foundation.h>
#import <netdb.h>
#import <mach/mach_time.h>

#pragma mark - Profile generation helpers

static NSString *PlatoDNSBuildProfile(NSString *proto) {
    NSString *rootUUID = [[NSUUID UUID] UUIDString];
    NSString *payloadUUID = [[NSUUID UUID] UUIDString];

    NSDictionary *dns;
    if ([proto isEqualToString:@"HTTPS"]) {
        dns = @{
            @"DNSProtocol": @"HTTPS",
            @"ServerURL": @"https://cloudflare-dns.com/dns-query",
            @"ServerAddresses": @[@"1.1.1.1", @"1.0.0.1"]
        };
    } else {
        dns = @{
            @"DNSProtocol": @"TLS",
            @"ServerName": @"cloudflare-dns.com",
            @"ServerAddresses": @[@"1.1.1.1", @"1.0.0.1"]
        };
    }

    NSDictionary *payload = @{
        @"PayloadType": @"com.apple.dnsSettings.managed",
        @"PayloadVersion": @1,
        @"PayloadIdentifier": [@"com.plato.platodns.dns." stringByAppendingString:proto.lowercaseString],
        @"PayloadUUID": payloadUUID,
        @"PayloadDisplayName": [@"PlatoDNS Cloudflare " stringByAppendingString:proto],
        @"PayloadDescription": @"Encrypted DNS configuration generated by PlatoDNS.",
        @"PayloadEnabled": @YES,
        @"PayloadContent": dns
    };

    NSDictionary *root = @{
        @"PayloadType": @"Configuration",
        @"PayloadVersion": @1,
        @"PayloadIdentifier": @"com.plato.platodns.profile",
        @"PayloadUUID": rootUUID,
        @"PayloadDisplayName": [@"PlatoDNS Cloudflare " stringByAppendingString:proto],
        @"PayloadDescription": @"Install this profile to configure encrypted DNS. iOS will ask for your approval in Settings.",
        @"PayloadOrganization": @"PlatoDNS",
        @"PayloadRemovalDisallowed": @NO,
        @"PayloadContent": @[payload]
    };

    NSData *data = [NSPropertyListSerialization dataWithPropertyList:root
        format:NSPropertyListXMLFormat_v1_0 options:0 error:nil];
    return data ? [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding] : nil;
}

#pragma mark - Floating menu UI

@interface PlatoDNSMenuView : UIView
@property (nonatomic, strong) UIWindow *hostWindow;
- (void)addRowTitle:(NSString *)title action:(SEL)action target:(id)target;
@end

@implementation PlatoDNSMenuView

- (instancetype)init {
    self = [super initWithFrame:CGRectMake(0, 0, 230, 190)];
    if (self) {
        self.backgroundColor = [UIColor colorWithWhite:0.08 alpha:0.96];
        self.layer.cornerRadius = 16;
        self.layer.borderWidth = 1;
        self.layer.borderColor = [UIColor colorWithWhite:1 alpha:0.12].CGColor;
        self.clipsToBounds = YES;

        UILabel *title = [[UILabel alloc] initWithFrame:CGRectMake(14, 10, 200, 22)];
        title.text = @"PlatoDNS";
        title.textColor = [UIColor whiteColor];
        title.font = [UIFont boldSystemFontOfSize:16];
        [self addSubview:title];

        UILabel *subtitle = [[UILabel alloc] initWithFrame:CGRectMake(14, 32, 200, 16)];
        subtitle.text = @"Encrypted DNS profiles (DoH/DoT)";
        subtitle.textColor = [UIColor colorWithWhite:1 alpha:0.55];
        subtitle.font = [UIFont systemFontOfSize:11];
        [self addSubview:subtitle];
    }
    return self;
}

- (void)addRowTitle:(NSString *)title action:(SEL)action target:(id)target {
    NSInteger index = self.subviews.count - 2; // minus the two labels
    CGFloat y = 54 + index * 42;
    UIButton *btn = [UIButton buttonWithType:UIButtonTypeSystem];
    btn.frame = CGRectMake(14, y, 202, 36);
    [btn setTitle:title forState:UIControlStateNormal];
    btn.titleLabel.font = [UIFont systemFontOfSize:14];
    btn.contentHorizontalAlignment = UIControlContentHorizontalAlignmentLeft;
    btn.backgroundColor = [UIColor colorWithWhite:1 alpha:0.06];
    btn.layer.cornerRadius = 8;
    [btn setTitleColor:[UIColor whiteColor] forState:UIControlStateNormal];
    [btn setTitleEdgeInsets:UIEdgeInsetsMake(0, 10, 0, 0)];
    [btn addTarget:target action:action forControlEvents:UIControlEventTouchUpInside];
    [self addSubview:btn];
}

@end

@interface PlatoDNSController : NSObject
@property (nonatomic, strong) UIWindow *bubbleWindow;
@property (nonatomic, strong) UIWindow *menuWindow;
@property (nonatomic, strong) UIButton *bubble;
+ (instancetype)shared;
- (void)presentFrom:(UIView *)anchor;
@end

@implementation PlatoDNSController

+ (instancetype)shared {
    static PlatoDNSController *s = nil;
    static dispatch_once_t once;
    dispatch_once(&once, ^{ s = [PlatoDNSController new]; });
    return s;
}

#pragma mark Bubble

- (void)installBubble {
    UIWindowScene *scene = nil;
    for (UIScene *s in [UIApplication sharedApplication].connectedScenes) {
        if ([s isKindOfClass:[UIWindowScene class]]) { scene = (UIWindowScene *)s; break; }
    }
    if (!scene) return;

    self.bubbleWindow = [[UIWindow alloc] initWithWindowScene:scene];
    self.bubbleWindow.frame = CGRectMake(20, 120, 50, 50);
    self.bubbleWindow.windowLevel = UIWindowLevelAlert + 1;
    self.bubbleWindow.backgroundColor = [UIColor clearColor];
    self.bubbleWindow.hidden = NO;

    UIButton *b = [UIButton buttonWithType:UIButtonTypeCustom];
    b.frame = CGRectMake(0, 0, 50, 50);
    b.backgroundColor = [UIColor colorWithRed:0.15 green:0.55 blue:0.95 alpha:0.92];
    b.layer.cornerRadius = 25;
    [b setTitle:@"🔒" forState:UIControlStateNormal];
    b.titleLabel.font = [UIFont systemFontOfSize:22];
    [b addTarget:self action:@selector(bubbleTapped:) forControlEvents:UIControlEventTouchUpInside];

    UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(bubbleDragged:)];
    [b addGestureRecognizer:pan];

    [self.bubbleWindow addSubview:b];
    self.bubbleWindow.rootViewController = [UIViewController new];
    self.bubbleWindow.rootViewController.view = b;
    self.bubble = b;
}

- (void)bubbleDragged:(UIPanGestureRecognizer *)g {
    CGPoint t = [g translationInView:nil];
    CGRect f = self.bubbleWindow.frame;
    f.origin.x += t.x;
    f.origin.y += t.y;
    self.bubbleWindow.frame = f;
    [g setTranslation:CGPointZero inView:nil];
}

- (void)bubbleTapped:(id)sender {
    [self presentFrom:self.bubble];
}

#pragma mark Menu

- (void)presentFrom:(UIView *)anchor {
    if (self.menuWindow) {
        [self dismissMenu];
        return;
    }

    UIWindowScene *scene = nil;
    for (UIScene *s in [UIApplication sharedApplication].connectedScenes) {
        if ([s isKindOfClass:[UIWindowScene class]]) { scene = (UIWindowScene *)s; break; }
    }
    if (!scene) return;

    self.menuWindow = [[UIWindow alloc] initWithWindowScene:scene];
    self.menuWindow.windowLevel = UIWindowLevelAlert + 2;
    self.menuWindow.backgroundColor = [UIColor clearColor];

    CGRect anchorFrameInScreen = self.bubbleWindow.frame;
    CGFloat x = MIN(anchorFrameInScreen.origin.x, scene.screen.bounds.size.width - 244);
    CGFloat y = anchorFrameInScreen.origin.y + 56;

    PlatoDNSMenuView *menu = [PlatoDNSMenuView new];
    menu.frame = CGRectMake(0, 0, 230, 190);

    [menu addRowTitle:@"⬇︎ Generate DoH profile" action:@selector(generateDoH) target:self];
    [menu addRowTitle:@"⬇︎ Generate DoT profile" action:@selector(generateDoT) target:self];
    [menu addRowTitle:@"⏱ Check DNS latency" action:@selector(checkLatency) target:self];
    [menu addRowTitle:@"✕ Close" action:@selector(dismissMenu) target:self];

    self.menuWindow.frame = CGRectMake(x, y, 230, 190);
    self.menuWindow.rootViewController = [UIViewController new];
    self.menuWindow.rootViewController.view = menu;
    self.menuWindow.hidden = NO;
}

- (void)dismissMenu {
    self.menuWindow.hidden = YES;
    self.menuWindow = nil;
}

#pragma mark Actions

- (UIViewController *)topViewController {
    UIWindowScene *scene = nil;
    for (UIScene *s in [UIApplication sharedApplication].connectedScenes) {
        if ([s isKindOfClass:[UIWindowScene class]]) { scene = (UIWindowScene *)s; break; }
    }
    UIWindow *key = nil;
    for (UIWindow *w in scene.windows) { if (w.isKeyWindow) { key = w; break; } }
    UIViewController *top = key.rootViewController;
    while (top.presentedViewController) top = top.presentedViewController;
    return top;
}

- (void)shareProfileWithProtocol:(NSString *)proto {
    NSString *xml = PlatoDNSBuildProfile(proto);
    if (!xml) return;
    NSString *name = [NSString stringWithFormat:@"PlatoDNS-%@.mobileconfig", proto];
    NSURL *url = [NSURL fileURLWithPath:[NSTemporaryDirectory() stringByAppendingPathComponent:name]];
    NSError *err = nil;
    [xml writeToURL:url atomically:YES encoding:NSUTF8StringEncoding error:&err];
    if (err) return;

    [self dismissMenu];

    dispatch_async(dispatch_get_main_queue(), ^{
        UIViewController *top = [self topViewController];
        if (!top) return;
        UIActivityViewController *share = [[UIActivityViewController alloc] initWithActivityItems:@[url] applicationActivities:nil];
        share.popoverPresentationController.sourceView = top.view;
        share.popoverPresentationController.sourceRect = CGRectMake(CGRectGetMidX(top.view.bounds), CGRectGetMaxY(top.view.bounds) - 20, 1, 1);
        [top presentViewController:share animated:YES completion:nil];
    });
}

- (void)generateDoH { [self shareProfileWithProtocol:@"HTTPS"]; }
- (void)generateDoT { [self shareProfileWithProtocol:@"TLS"]; }

- (void)checkLatency {
    [self dismissMenu];
    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
        struct addrinfo hints = {0}, *result = NULL;
        hints.ai_socktype = SOCK_STREAM;
        hints.ai_family = AF_UNSPEC;
        uint64_t start = mach_continuous_time();
        int status = getaddrinfo("cloudflare.com", NULL, &hints, &result);
        uint64_t end = mach_continuous_time();
        if (result) freeaddrinfo(result);
        mach_timebase_info_data_t info;
        mach_timebase_info(&info);
        double ms = ((double)(end - start) * info.numer / info.denom) / 1000000.0;
        NSString *message = status == 0
            ? [NSString stringWithFormat:@"DNS resolution completed in %.1f ms.\nThis is a basic system resolver timing check, not a guarantee of the exact encrypted DNS path.", ms]
            : [NSString stringWithFormat:@"DNS lookup failed (getaddrinfo: %d).", status];

        dispatch_async(dispatch_get_main_queue(), ^{
            UIViewController *top = [self topViewController];
            if (!top) return;
            UIAlertController *a = [UIAlertController alertControllerWithTitle:@"PlatoDNS" message:message preferredStyle:UIAlertControllerStyleAlert];
            [a addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:nil]];
            [top presentViewController:a animated:YES completion:nil];
        });
    });
}

@end

#pragma mark - Entry point

__attribute__((constructor))
static void PlatoDNSInit(void) {
    dispatch_async(dispatch_get_main_queue(), ^{
        // Give the host app a moment to finish launching before adding our window.
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            [[PlatoDNSController shared] installBubble];
            NSLog(@"[PlatoDNS] Loaded (standalone, no jailbreak). Tap the 🔒 bubble to open the menu.");
        });
    });
}
